---
import PhotoCarousel from "./PhotoCarousel.astro";
import { weddingPhotos } from "../data/weddingPhotos";
interface Offer {
	title: string;
	copy: string;
}

interface Step {
	title: string;
	copy: string;
}

interface Props {
	eyebrow: string;
	title: string;
	lead: string | string[];
	offersHeading: string;
	offers: Offer[];
	highlightOffers?: boolean;
	pinkOffers?: boolean;
	darkOffers?: boolean;
	weddingHero?: boolean;
	steps: Step[];
}

const { eyebrow, title, lead, offersHeading, offers, steps, highlightOffers = false, pinkOffers = false, darkOffers = false, weddingHero = false } = Astro.props;
---

<main id="main">
	<section class:list={["service-hero", { "service-hero--dark": weddingHero }]} >
	<div class="page-hero page-width">
		<div class="page-hero__copy">
			<p class="eyebrow">{eyebrow}</p>
			<h1 set:html={title} />
			{(Array.isArray(lead) ? lead : [lead]).map((paragraph) => <p class="hero-lead">{paragraph}</p>)}
			<a class="button" href="/#contact">Let's plan your event</a>
		</div>
		<slot name="hero-media">
		{weddingHero ? <PhotoCarousel photos={weddingPhotos} label="Wedding photos" galleryBase="/weddings/gallery/" emptyMessage="Wedding photos coming soon" /> : <div class="page-hero__art" aria-hidden="true">
			<span class="page-hero__art-disc"></span>
			<span class="page-hero__art-label">MAKE<br />IT A<br /><em>NIGHT.</em></span>
		</div>}
		</slot>
	</div>
	</section>

	<slot name="after-hero" />

	<section class="section page-width">
		<div class="section-heading">
			<div>
				<p class="eyebrow">The good stuff</p>
				<h2><slot name="offers-heading">{weddingHero ? <>Everything your <em>celebration</em> needs.</> : offersHeading}</slot></h2>
			</div>

		</div>
		<div class="service-pricing">
			<h3>No cookie-cutter packages.<br /><em>No guesswork.</em></h3>
			<p>Every event is different, and your entertainment should reflect that.</p>
			<p>Rather than asking you to choose from a list of packages, I take the time to understand your event, your priorities, and what it will take to deliver the experience you're looking for.</p>
			<p>From there, I'll put together a personalized proposal with clear pricing and everything needed to make your event look and sound its best. Whether that's premium sound, microphones, uplighting, or other production essentials, it's all accounted for upfront and included in your proposal.</p>
			<p><strong>No unnecessary extras. No confusing packages. No surprise add-ons. Just one straightforward price for everything we've planned together.</strong></p>
		</div>
		<div class:list={["offer-grid", { "offer-grid--highlighted": highlightOffers, "offer-grid--pink": pinkOffers, "offer-grid--dark": darkOffers }]}>
			{offers.map((offer, index) => (
				<article class="offer-card">
					<span class="offer-card__number">0{index + 1}</span>
					<h3>{offer.title}</h3>
					<p>{offer.copy}</p>
				</article>
			))}
		</div>
	</section>

	<slot name="planning">
	{steps.length > 0 && <section class="steps-band">
		<div class="page-width">
			<p class="eyebrow">Easy does it</p>
			<h2>How we make it <em>happen.</em></h2>
			<div class="steps-grid">
				{steps.map((step, index) => (
					<article class="step-card">
						<span class="step-card__number">0{index + 1}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>}

	</slot>

	<slot />
</main>

<style>
	.service-hero--dark { background: #000; color: #fff; }
	.service-hero--dark :global(h1) { color: #fff; font-weight: 900; }
	.service-hero--dark :global(.hero-lead) { color: #fff; }
	.service-pricing { max-width: 880px; margin-bottom: 40px; padding: clamp(24px, 4vw, 48px); background: #000; color: #fff; line-height: 1.8; }
	.service-pricing h3 { color: #fff; font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.2; font-weight: 900; margin-bottom: 24px; }
	.service-pricing h3 em { color: var(--pink); }
</style>
