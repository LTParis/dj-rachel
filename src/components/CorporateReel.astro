---
import { corporateReel } from "../data/corporateReel";
---

<aside class="corporate-reel" aria-labelledby="corporate-reel-heading">
	<h3 id="corporate-reel-heading">Corporate sizzle reel</h3>
	{corporateReel ? (
		<video controls playsinline preload="none" poster={corporateReel.poster} width={corporateReel.width} height={corporateReel.height} aria-labelledby="corporate-reel-heading">
			<source src={corporateReel.src} type="video/mp4" />
			<p>Your browser doesn’t support embedded video. <a href={corporateReel.src}>Watch the corporate sizzle reel</a>.</p>
		</video>
	) : (
		<div class="corporate-reel__placeholder">
			<svg width="56" height="56" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="12" width="27" height="25" rx="4" /><path d="m32 20 11-6v22l-11-6" stroke-linejoin="round" /></svg>
			<p>Corporate event video<br /><em>coming soon.</em></p>
		</div>
	)}
</aside>

<style>
	.corporate-reel { min-width: 0; width: 100%; max-width: 440px; margin-inline: auto; }
	h3 { margin-bottom: 18px; font-family: var(--display); font-size: 1.2rem; font-weight: 900; }
	video { display: block; width: 100%; height: auto; max-height: 760px; object-fit: contain; border: 3px solid var(--pink); border-radius: 10px; background: #000; }
	.corporate-reel__placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; aspect-ratio: 9 / 16; padding: 24px; border: 3px solid var(--pink); border-radius: 10px; background: #180f14; text-align: center; }
	svg { flex-shrink: 0; margin-bottom: 28px; color: var(--pink); }
	p { margin-bottom: 0; font-family: var(--display); font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 900; line-height: 1.3; }
	em { color: var(--pink); font-style: normal; }
	@media (max-width: 800px) { .corporate-reel__placeholder { aspect-ratio: 5 / 4; } }
</style>
