---
import SiteLayout from "../layouts/SiteLayout.astro";
import ServicePage from "../components/ServicePage.astro";
import ContactCta from "../components/ContactCta.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import { partyPhotos } from "../data/partyPhotos";
---

<SiteLayout title="Private Party DJ | DJ Rachel Lynch" description="Make birthdays, anniversaries, reunions, graduations, and private celebrations memorable with DJ Rachel Lynch.">
	<ServicePage
		eyebrow="Private events"
		title="your party,<br /><em>your people,</em><br />your way."
		lead="Milestones. Birthdays. Reunions. Graduations. Sweet sixteens. Anniversaries. Any excuse to party? I’m in."
		offersHeading="what are we celebrating?"
		darkOffers
		offers={[
			{ title: "Milestone birthdays", copy: "A night shaped around the guest of honor and all their favorite people." },
			{ title: "Sweet sixteens + graduations", copy: "A celebration with room for friends, family, and a playlist everyone can enjoy." },
			{ title: "Anniversaries + reunions", copy: "Bring people together with music that makes the memories feel close." },
			{ title: "Just wanna party? Let's do it.", copy: "A setup and soundtrack suited to your space and the kind of party you want." },
		]}
		steps={[
			{ title: "Tell me about it", copy: "Share what you're celebrating, where it is, and who will be there." },
			{ title: "Pick your sound", copy: "Talk through favorite songs, special moments, and the feel of the party." },
			{ title: "Enjoy the party", copy: "Be with your guests while the music brings the night together." },
		]}
	>
		<PhotoCarousel slot="hero-media" photos={partyPhotos} label="Party photos" />
		<section slot="after-hero" class="section page-width event-story" aria-labelledby="event-story-heading">
			<h2 id="event-story-heading">Your people. Your music. <em>Your kind of party.</em></h2>
			<div class="event-story__copy">
				<p>Some occasions deserve more than just getting everyone together. They deserve a celebration people will still be talking about long after the last song.</p>
				<p>Maybe it's a milestone birthday, a long-overdue reunion, a graduation, or simply an excuse to bring all your favorite people into one room.</p>
				<p>Whatever we're celebrating, I'll help you find the right soundtrack, the right energy, and the right approach for your crowd.</p>
				<p>Big dance floor energy? Absolutely. Something more laid-back? We can do that too.</p>
				<p>No default playlists. No overcomplicating things. Just great music, good company, and a celebration that feels exactly the way you want it to.</p>
			</div>
		</section>
		<ContactCta />
	</ServicePage>
</SiteLayout>

<style>
	.event-story { padding-top: 40px; }
	.event-story h2 { text-transform: none; }
	.event-story__copy { max-width: 800px; margin-top: 32px; font-size: 1.1rem; line-height: 1.8; }
</style>
