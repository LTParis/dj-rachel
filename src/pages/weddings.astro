---
import SiteLayout from "../layouts/SiteLayout.astro";
import ServicePage from "../components/ServicePage.astro";
import ContactCta from "../components/ContactCta.astro";
---

<SiteLayout title="Wedding DJ & MC | DJ Rachel Lynch" description="Plan a wedding soundtrack that feels like you with DJ Rachel Lynch. Wedding DJ and MC services, ceremony audio, and thoughtful event coordination.">
	<ServicePage
		eyebrow="Wedding DJ + MC"
		title="your love story,<br /><em>your vibe,</em><br />your way."
		lead="No cookie-cutter playlist here. Plan your music and moments in your personalized app. Then, when your wedding day finally arrives, soak in every second. I've got the rest."
		offersHeading="everything your celebration needs"
		offers={[
			{ title: "Ceremony", copy: "Every vow heard. Every cue perfectly timed. Microphones and music for the moments that matter most." },
			{ title: "Cocktail hour", copy: "A personalized soundtrack that sets the vibe and leaves room for conversation." },
			{ title: "Reception + dance floor", copy: "Your favorite songs, performed like you've never heard them. Your people. Nobody sits this one out." },
			{ title: "MC + timeline", copy: "A warm voice on the mic and every key moment coordinated with your vendor team, so your day feels effortless." },
		]}
		steps={[
			{ title: "Let's talk", copy: "Share your plans, your people, and the kind of night you want." },
			{ title: "Make the plan", copy: "Gather the songs, special moments, and event details that matter to you." },
			{ title: "Enjoy your day", copy: "Be with your people while the music and schedule come together." },
		]}
	>
		<ContactCta />
	</ServicePage>
</SiteLayout>
