---
import PhotoCarousel from "./PhotoCarousel.astro";
import { weddingPhotos } from "../data/weddingPhotos";
interface Offer {
	title: string;
	copy: string;
}

interface Step {
	title: string;
	copy: string;
}

interface Props {
	eyebrow: string;
	title: string;
	lead: string | string[];
	offersHeading: string;
	offers: Offer[];
	highlightOffers?: boolean;
	pinkOffers?: boolean;
	darkOffers?: boolean;
	weddingHero?: boolean;
	steps: Step[];
}

const { eyebrow, title, lead, offersHeading, offers, steps, highlightOffers = false, pinkOffers = false, darkOffers = false, weddingHero = false } = Astro.props;
---

<main id="main">
	<section class="page-hero page-width">
		<div class="page-hero__copy">
			<p class="eyebrow">{eyebrow}</p>
			<h1 set:html={title} />
			{(Array.isArray(lead) ? lead : [lead]).map((paragraph) => <p class="hero-lead">{paragraph}</p>)}
			<a class="button" href="/#contact">Let's plan your event</a>
		</div>
		<slot name="hero-media">
		{weddingHero ? <PhotoCarousel photos={weddingPhotos} label="Wedding photos" galleryBase="/weddings/gallery/" emptyMessage="Wedding photos coming soon" /> : <div class="page-hero__art" aria-hidden="true">
			<span class="page-hero__art-disc"></span>
			<span class="page-hero__art-label">MAKE<br />IT A<br /><em>NIGHT.</em></span>
		</div>}
		</slot>
	</section>

	<slot name="after-hero" />

	<section class="section page-width">
		<div class="section-heading">
			<div>
				<p class="eyebrow">The good stuff</p>
				<h2>{weddingHero ? <>everything your <em>celebration</em> needs</> : offersHeading}</h2>
			</div>
			<p class="section-aside service-details">Tell me what matters most. No packages to decode. No equipment to worry about. Just my very best, built around your event, from start to finish.</p>
		</div>
		<div class:list={["offer-grid", { "offer-grid--highlighted": highlightOffers, "offer-grid--pink": pinkOffers, "offer-grid--dark": darkOffers }]}>
			{offers.map((offer, index) => (
				<article class="offer-card">
					<span class="offer-card__number">0{index + 1}</span>
					<h3>{offer.title}</h3>
					<p>{offer.copy}</p>
				</article>
			))}
		</div>
	</section>

	<slot name="planning">
	<section class="steps-band">
		<div class="page-width">
			<p class="eyebrow">Easy does it</p>
			<h2>how we make it <em>happen.</em></h2>
			<div class="steps-grid">
				{steps.map((step, index) => (
					<article class="step-card">
						<span class="step-card__number">0{index + 1}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	</slot>

	<slot />
</main>

<style>
	.service-details { color: #000; font-weight: 800; }
</style>
