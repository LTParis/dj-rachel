---
import { weddingClips } from "../data/weddingClips";
const slots = Array.from({ length: 6 }, (_, index) => ({ clip: weddingClips[index], number: index + 1 }));
---

<wedding-testimonials class="wedding-clips" role="region" aria-labelledby="wedding-testimonials-heading">
	<h3 id="wedding-testimonials-heading">Real weddings.<br /><em>Real moments.</em></h3>
	<p class="wedding-clips__intro">Take a look at what happens when it all comes together.</p>
	<p class="wedding-clips__closing">Because an unforgettable celebration is about more than what you hear. It's about how you and your guests feel from start to finish.</p>
	<div class="wedding-clips__grid" role="group" aria-labelledby="wedding-testimonials-heading">
		{slots.map(({ clip, number }) => clip ? (
			<button class="testimonial-card" type="button" data-src={clip.src} data-title={clip.title} data-poster={clip.poster} data-captions={clip.captions} aria-label={`Watch ${clip.title}`} aria-haspopup="dialog">
				<span class="testimonial-card__media">
					{clip.poster && <img src={clip.poster} alt="" width={640} height={360} loading="lazy" />}
					<span class="testimonial-card__play" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 4v16l12-8z" /></svg></span>
				</span>
				<span class="testimonial-card__label">{clip.title}</span>
			</button>
		) : (
			<div class="testimonial-card testimonial-card--empty">
				<span class="testimonial-card__media"><span class="testimonial-card__number" aria-hidden="true">0{number}</span></span>
				<span class="testimonial-card__label">Video coming soon</span>
			</div>
		))}
	</div>
	<dialog class="wedding-clips__dialog" aria-label="Wedding video testimonial">
		<div class="wedding-clips__player">
			<div class="wedding-clips__toolbar">
				<p class="wedding-clips__title"></p>
				<button class="wedding-clips__close" type="button" aria-label="Close video">Close <span aria-hidden="true">×</span></button>
			</div>
			<video controls playsinline preload="none" aria-label="Wedding video testimonial"></video>
		</div>
	</dialog>
</wedding-testimonials>

<script>
	class WeddingTestimonials extends HTMLElement {
		connectedCallback() {
			const dialog = this.querySelector<HTMLDialogElement>("dialog");
			const video = this.querySelector<HTMLVideoElement>("video");
			const title = this.querySelector<HTMLElement>(".wedding-clips__title");
			if (!dialog || !video || !title) return;
			let previousOverflow = "";
			this.querySelectorAll<HTMLButtonElement>("button[data-src]").forEach((button) => {
				button.addEventListener("click", () => {
					video.src = button.dataset.src!;
					video.poster = button.dataset.poster || "";
					video.setAttribute("aria-label", button.dataset.title!);
					title.textContent = button.dataset.title!;
					video.querySelectorAll("track").forEach((track) => track.remove());
					if (button.dataset.captions) {
						const track = document.createElement("track");
						track.kind = "captions";
						track.srclang = "en";
						track.label = "English";
						track.src = button.dataset.captions;
						track.default = true;
						video.append(track);
					}
					previousOverflow = document.documentElement.style.overflow;
					document.documentElement.style.overflow = "hidden";
					dialog.showModal();
					video.play().catch(() => { /* Native controls remain available if playback is blocked. */ });
				});
			});
			this.querySelector(".wedding-clips__close")?.addEventListener("click", () => dialog.close());
			dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
			dialog.addEventListener("close", () => {
				video.pause();
				video.removeAttribute("src");
				video.load();
				document.documentElement.style.overflow = previousOverflow;
			});
		}
	}
	if (!customElements.get("wedding-testimonials")) customElements.define("wedding-testimonials", WeddingTestimonials);
</script>

<style>
	.wedding-clips { display: block; min-width: 0; width: 100%; margin-top: 48px; padding: clamp(20px, 3vw, 36px); border: 3px solid var(--pink); border-radius: 12px; background: #000; color: #fff; }
	h3 { margin-bottom: 20px; font-family: var(--display); font-size: clamp(1.75rem, 3.5vw, 3.25rem); font-weight: 900; line-height: 1.15; letter-spacing: -.03em; text-wrap: balance; }
	h3 em { color: var(--pink); font-style: normal; }
	.wedding-clips__intro, .wedding-clips__closing { max-width: 800px; margin-bottom: 20px; font-size: 1rem; line-height: 1.7; }
	.wedding-clips__closing { margin-bottom: 32px; }
	.wedding-clips__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 2vw, 24px); }
	.testimonial-card { display: flex; flex-direction: column; width: 100%; min-width: 0; overflow: hidden; padding: 0; border: 1px solid #a82c65; border-radius: 6px; background: #1c1218; color: #fff; text-align: center; font: inherit; font-size: .9rem; line-height: 1.4; }
	.testimonial-card__media { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 16 / 9; min-height: 88px; }
	button.testimonial-card { cursor: pointer; }
	button.testimonial-card:hover, button.testimonial-card:focus-visible { border-color: #fff; outline: 3px solid var(--pink); outline-offset: 3px; }
	.testimonial-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.testimonial-card__play { z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--pink); color: #fff; }
	.testimonial-card__label { display: block; width: 100%; padding: 12px 8px; font-family: var(--display); font-weight: 700; overflow-wrap: anywhere; }
	.testimonial-card__number { color: #f17eb2; font-family: var(--display); font-size: 1.6rem; font-weight: 900; }
	.wedding-clips__dialog { width: min(960px, calc(100% - 24px)); max-width: none; max-height: 95dvh; padding: 0; border: 2px solid var(--pink); border-radius: 10px; background: #000; color: #fff; }
	.wedding-clips__dialog::backdrop { background: #000d; }
	.wedding-clips__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; }
	.wedding-clips__title { margin: 0; overflow-wrap: anywhere; font-family: var(--display); font-weight: 700; }
	.wedding-clips__close { min-height: 44px; padding: 8px 14px; flex-shrink: 0; border: 2px solid var(--pink); border-radius: 4px; background: #000; color: #fff; font: inherit; cursor: pointer; }
	video { display: block; width: 100%; height: auto; max-height: 75dvh; object-fit: contain; background: #000; }
	@media (max-width: 800px) { .wedding-clips__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
