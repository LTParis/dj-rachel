---
import SiteLayout from "../layouts/SiteLayout.astro";
import ServicePage from "../components/ServicePage.astro";
import ContactCta from "../components/ContactCta.astro";
import BrandClients from "../components/BrandClients.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import { corporatePhotos } from "../data/corporatePhotos";
---

<SiteLayout title="Corporate Event DJ | DJ Rachel Lynch" description="DJ and event-host services for corporate events, brand activations, grand openings, company celebrations, and galas.">
	<ServicePage
		eyebrow="Corporate + brand events"
		title="your brand,<br /><em>your crowd,</em><br />my energy."
		lead={[
			"Store events. Grand openings. Galas. Holiday parties. And everything in between.",
			"Corporate doesn’t have to mean stiff. I curate the music, host the room, and make your brand sound as good as it looks, with polish where it counts and personality everywhere else.",
			"Deliberate, never generic. No awkward silences. No off-brand song choices. Nothing forgettable.",
			"Your guests won’t just remember the event. They’ll remember whose it was.",
		]}
		offersHeading="events we can shape together"
		pinkOffers
		offers={[
			{ title: "Retail + brand activations", copy: "Pop-ups. Product launches. In-store moments. I curate music that pulls people in off the sidewalk and keeps them browsing. Your brand is the star. I bring the soundtrack so shoppers stop, linger, and walk away remembering you." },
			{ title: "Grand openings", copy: "From the first guest through the door to the ribbon cutting, I bring the vibe and the mic. Your opening starts with a bang, not a whisper, because a milestone like this deserves to be celebrated big." },
			{ title: "Company celebrations", copy: "From polished background sound to a dance floor your team still talks about on Monday, I plan every moment around your brand, so the room always feels right." },
			{ title: "Galas + fundraisers", copy: "Sound for speeches and key moments, with music to close out the night." },
		]}
		steps={[
			{ title: "Share the brief", copy: "Talk through your audience, venue, schedule, and event goals." },
			{ title: "Set the tone", copy: "Choose the music and sound details that fit your brand and run of show." },
			{ title: "Bring it to life", copy: "Enjoy the event while the agreed plan guides the music and mic moments." },
		]}
	>
		<PhotoCarousel slot="hero-media" photos={corporatePhotos} label="Corporate and brand event photos" />
		<BrandClients slot="after-hero" />
		<ContactCta />
	</ServicePage>
</SiteLayout>
