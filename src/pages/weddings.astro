---
import SiteLayout from "../layouts/SiteLayout.astro";
import ServicePage from "../components/ServicePage.astro";
import ContactCta from "../components/ContactCta.astro";
---

<SiteLayout title="Wedding DJ & MC | DJ Rachel Lynch" description="Plan a wedding soundtrack that feels like you with DJ Rachel Lynch. Wedding DJ and MC services, ceremony audio, and thoughtful event coordination.">
	<ServicePage
		eyebrow="Wedding DJ + MC"
		title="your love story,<br /><em>your vibe,</em><br />your way."
		lead="No cookie-cutter playlist here. Plan your music and moments in your personalized wedding app. Then, when your wedding day finally arrives, soak in every second. I've got the rest."
		offersHeading="everything your celebration needs"
		weddingHero
		highlightOffers
		offers={[
			{ title: "Ceremony", copy: "Every vow heard. Every cue perfectly timed. Microphones and music for the moments that matter most." },
			{ title: "Cocktail hour", copy: "A personalized soundtrack that sets the tone, leaves room to talk, and builds toward the night ahead." },
			{ title: "Reception + dance floor", copy: "This is the part everyone talks about the next day. Your favorite songs, performed like you've never heard them. Your people. Your energy. Smiles and hands in the air all night. Nobody sits this one out. Not even grandma." },
			{ title: "MC + timeline", copy: "A warm voice on the mic. Every key moment coordinated with your vendor team. A day that feels effortless, whatever happens behind the scenes." },
		]}
		steps={[
			{ title: "Let's talk", copy: "Tell me about your plans, your people, and the night you're picturing. What matters most? How should it feel? How should it sound?" },
			{ title: "Make the plan", copy: "We build it together in your personalized wedding app: the songs, the special moments, and every detail most important to you." },
			{ title: "Enjoy your day", copy: "Dance. Eat. Celebrate. Enjoy every moment. I'll make sure the music and the schedule come together flawlessly." },
		]}
	>
		<ContactCta />
	</ServicePage>
</SiteLayout>
