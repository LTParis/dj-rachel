---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import ContactCta from "../components/ContactCta.astro";
import ReviewHighlights from "../components/ReviewHighlights.astro";
import HeroReviews from "../components/HeroReviews.astro";
import { serviceCards, values } from "../data/site";
---

<SiteLayout
	title="DJ Rachel Lynch | Connecticut Wedding & Event DJ"
	description="DJ Rachel Lynch brings personalized DJ and MC services to weddings, corporate events, and private celebrations in Connecticut and across the Northeast."
>
	<main id="main">
		<section class="hero page-width">
			<div class="hero-copy">
				<p class="eyebrow">DJ · Event host · Party rocker</p>
				<h1 class="hero-title">your vibe,<br /><em>your way.</em></h1>
				<p class="hero-lead">
					I’m a Party Rocker, DJ, and MC for weddings, corporate events, and nights worth celebrating.
					Flawless mixes. No cheesy gimmicks. Thoughtful planning. A celebration that feels like it was made for you.
				</p>
				<div class="button-row">
					<a class="button" href="#contact">Let’s connect</a>
					<a class="text-link" href="/about/">Get to know Rachel <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<div class="hero-media">
				<!-- Placeholder until Rachel approves the sizzle reel. Final: muted, looping
				     vertical video with a still poster frame that loads first. -->
				<div class="hero-reel">
					<svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M10 8l6 4-6 4z" /></svg>
					<p class="hero-reel__title">Sizzle reel</p>
					<p class="hero-reel__note">Rachel's best event clips will play here: a muted loop with a still frame that loads first.</p>
				</div>
				<HeroReviews />
			</div>
		</section>

		<section class="intro-strip" aria-label="At a glance">
			<div class="page-width intro-strip__inner">
				<p>Music for everyone</p>
				<span aria-hidden="true">✳</span>
				<p>DJ + MC</p>
				<span aria-hidden="true">✳</span>
				<p>Weddings · Corporate · Private Parties</p>
			</div>
		</section>

		<section class="section page-width">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Bring your people. I’ll bring the party.</p>
					<h2>what are we<br /><em>celebrating?</em></h2>
				</div>
				<p class="section-aside">One great night can sound a hundred different ways. Let's make it yours.</p>
			</div>
			<div class="service-grid">
				{serviceCards.map((service) => (
					<a class="service-card" href={service.href}>
						<span class={`service-card__image service-card__image--${service.tone}`}>
							{service.image ? (
								<Image src={service.image} alt={service.imageAlt} widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" width={900} format="webp" loading="lazy" />
							) : <span>{service.imageLabel}</span>}
						</span>
						<span class="service-card__content">
							<span class="service-card__eyebrow">{service.eyebrow}</span>
							<h3>{service.title}</h3>
							<span class="service-card__copy">{service.copy}</span>
							<span class="service-card__link">Explore {service.shortTitle} <span aria-hidden="true">→</span></span>
						</span>
					</a>
				))}
			</div>
		</section>

		<ReviewHighlights />

		<section class="about-band">
			<div class="page-width about-band__inner">
				<div class="photo-placeholder">
					<span>Rachel's photo goes here</span>
				</div>
				<div class="about-band__copy">
					<p class="eyebrow">A little about me</p>
					<h2>the best nights<br />feel like <em>you.</em></h2>
					<p>
						The story, favorite moments, and behind-the-booth photos belong here.
						Rachel will add the details in her own words.
					</p>
					<a class="text-link" href="/about/">Meet Rachel <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</section>

		<section class="section page-width">
			<div class="section-heading">
				<div>
					<p class="eyebrow">The feeling we're after</p>
					<h2>made for your<br /><em>kind of night.</em></h2>
				</div>
			</div>
			<div class="value-grid">
				{values.map((value, index) => (
					<article class="value-card">
						<span class="value-card__number">0{index + 1}</span>
						<h3>{value.title}</h3>
						<p>{value.copy}</p>
					</article>
				))}
			</div>
		</section>

		<ContactCta />
	</main>
</SiteLayout>
