---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
 photos: { src: string | ImageMetadata; alt: string }[];
 label: string;
 emptyMessage?: string;
 galleryBase?: string;
}
const { photos, label, galleryBase, emptyMessage = "Event photos coming soon" } = Astro.props;
const slides = await Promise.all(photos.map(async (photo) => {
 if (typeof photo.src === "string") return { ...photo, width: 800, height: 800 };
 const image = await getImage({ src: photo.src, width: 1440, format: "webp" });
 return { src: image.src, alt: photo.alt, width: image.attributes.width, height: image.attributes.height };
}));
---

<photo-carousel class="page-hero__art photo-carousel" role="region" aria-label={label} aria-roledescription="carousel">
	{slides.length ? slides.map((photo, index) => (
		<img src={photo.src} alt={photo.alt} hidden={index !== 0} width={photo.width} height={photo.height} loading={index === 0 ? "eager" : "lazy"} />
	)) : <p class="photo-carousel__placeholder">{emptyMessage}</p>}
	{galleryBase && slides.length > 0 && <a class="photo-carousel__gallery" href={`${galleryBase}1/`} aria-label="Open wedding photo gallery"><span>View photo gallery ↗</span></a>}
	{slides.length > 1 && <div class="photo-carousel__controls">
		<button type="button" data-previous aria-label="Previous event photo">←</button>
		<button type="button" data-pause>Pause slideshow</button>
		<button type="button" data-next aria-label="Next event photo">→</button>
	</div>}
</photo-carousel>

<script>
	class PhotoCarousel extends HTMLElement {
		connectedCallback() {
			const photos = [...this.querySelectorAll("img")];
			if (photos.length < 2) return;
			let index = 0;
			let paused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const gallery = this.querySelector<HTMLAnchorElement>(".photo-carousel__gallery");
			const pause = this.querySelector<HTMLButtonElement>("[data-pause]")!;
			const updatePause = () => { pause.textContent = paused ? "Play slideshow" : "Pause slideshow"; };
			const show = (offset: number) => {
				photos[index].hidden = true;
				index = (index + offset + photos.length) % photos.length;
				photos[index].hidden = false;
				if (gallery) gallery.href = gallery.href.replace(/\d+\/$/, `${index + 1}/`);
			};
			this.querySelector("[data-previous]")?.addEventListener("click", () => show(-1));
			this.querySelector("[data-next]")?.addEventListener("click", () => show(1));
			pause.addEventListener("click", () => { paused = !paused; updatePause(); });
			updatePause();
			const timer = window.setInterval(() => {
				if (!paused && !document.hidden && !this.matches(":hover, :focus-within")) show(1);
			}, 5000);
			this.cleanup = () => window.clearInterval(timer);
		}
		cleanup?: () => void;
		disconnectedCallback() { this.cleanup?.(); }
	}
	if (!customElements.get("photo-carousel")) customElements.define("photo-carousel", PhotoCarousel);
</script>

<style>
	.photo-carousel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.photo-carousel img[hidden] { display: none; }
	.photo-carousel__placeholder { padding: 24px; text-align: center; font-weight: 700; }
	.photo-carousel__gallery { position: absolute; inset: 0; color: white; }
	.photo-carousel__gallery span { position: absolute; top: 12px; right: 12px; padding: 8px 12px; background: #000; font-weight: 700; }
	.photo-carousel__gallery:focus-visible { outline: 4px solid var(--pink); outline-offset: -4px; }
	.photo-carousel__controls { position: absolute; inset: auto 12px 12px; display: flex; justify-content: center; gap: 8px; }
	.photo-carousel__controls button { padding: 10px 14px; border: 2px solid white; background: #191216; color: white; cursor: pointer; font: inherit; }
</style>
