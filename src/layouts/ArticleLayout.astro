---
import SiteLayout from "./SiteLayout.astro";
const { frontmatter } = Astro.props;
---
<SiteLayout title={`${frontmatter.title} | DJ Rachel Lynch`} description={frontmatter.description}>
	<main id="main" class="page-width article">
		<a class="text-link" href="/writing/">← All writing</a>
		<header>
			<p class="eyebrow">{frontmatter.topic}</p>
			<h1>{frontmatter.title}</h1>
			<p>By DJ Rachel Lynch</p>
		</header>
		<div class="article-body"><slot /></div>
	</main>
</SiteLayout>
<style>
	.article { max-width: 820px; padding-block: 50px 90px; }
	header { margin-block: 35px; }
	h1 { font-size: clamp(2.5rem, 6vw, 5rem); text-transform: none; overflow-wrap: anywhere; }
	.article-body { font-size: 1.1rem; line-height: 1.8; overflow-wrap: anywhere; }
	.article-body :global(img) { max-width: 100%; height: auto; }
	.article-body :global(h2) { font-size: 2.2rem; line-height: 1.15; margin-top: 40px; text-transform: none; }
	.article-body :global(a) { text-decoration-color: var(--pink); }
</style>
