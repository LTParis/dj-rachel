---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import rachelPortrait from "../assets/photos/485803166_3118932788254150_7100244311701559589_n.jpg";
import ContactCta from "../components/ContactCta.astro";

const site = Astro.site!;
// Structured data for the homepage sizzle reel. uploadDate is when the reel was first published on this site.
const reelSchema = {
	"@type": "VideoObject",
	"@id": new URL("/#sizzle-reel", site).href,
	name: "DJ Rachel wedding and event sizzle reel",
	description: "Highlights from weddings and events with DJ Rachel Lynch.",
	thumbnailUrl: new URL("/homepage-sizzle-poster.jpg", site).href,
	contentUrl: new URL("/homepage-sizzle-reel.mp4", site).href,
	uploadDate: "2026-11-24T01:18:01Z",
	duration: "PT53S",
	publisher: { "@id": new URL("/#organization", site).href },
};
import ReviewHighlights from "../components/ReviewHighlights.astro";
import { serviceCards } from "../data/site";
---

<SiteLayout
	schema={[reelSchema]}
	title="DJ Rachel Lynch | Connecticut Wedding & Event DJ"
	description="DJ Rachel Lynch brings personalized DJ and MC services to weddings, corporate events, and private celebrations in Connecticut and across the Northeast."
>
	<main id="main">
		<section class="home-hero">
		<div class="hero page-width">
			<div class="hero-heading">
				<p class="eyebrow">Connecticut Wedding &amp; Event DJ · Serving the Northeast</p>
				<h1 class="hero-title">Your vibe.<br /><em>Your way.</em></h1>
			</div>
			<div class="hero-media">
				<video class="hero-reel" autoplay muted loop controls playsinline preload="metadata" poster="/homepage-sizzle-poster.jpg" width="720" height="1280" aria-label="DJ Rachel wedding and event sizzle reel">
					<source src="/homepage-sizzle-reel-mobile.mp4" type="video/mp4" media="(max-width: 700px)" />
					<source src="/homepage-sizzle-reel.mp4" type="video/mp4" />
					<p>Your browser doesn’t support embedded video. <a class="button" href="/homepage-sizzle-reel.mp4">Watch the sizzle reel</a>.</p>
				</video>
				<button class="button button--small hero-sound-toggle" type="button" data-hero-sound aria-label="Turn video sound on" hidden>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 5-5 4H3v6h3l5 4z" /><path d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></svg>
					<span>Sound on</span>
				</button>
			</div>
			<div class="hero-copy">
				<p class="hero-lead"><strong>I'm DJ Rachel, an open-format DJ and MC bringing creative, high-energy entertainment to weddings, corporate events, private parties, and moments worth celebrating throughout Connecticut and the Northeast.</strong></p>
				<p class="hero-lead"><strong>But great music is just the beginning.</strong></p>
				<p class="hero-lead">Club-style mixing. Packed dance floors. No cheesy gimmicks. Thoughtful planning, professional hosting, and an experience that feels entirely your own.</p>
				<div class="button-row">
					<a class="button" href="#contact">Let’s connect</a>
					<a class="button" href="/about/">Get to know Rachel</a>
				</div>
			</div>
		</div>
		</section>

		<section class="intro-strip" aria-label="At a glance">
			<div class="page-width intro-strip__inner">
				<p>Music for everyone</p>
				<span aria-hidden="true">✳</span>
				<p>DJ + MC</p>
				<span aria-hidden="true">✳</span>
				<p>Weddings · Corporate · Private Parties</p>
			</div>
		</section>

		<section class="section page-width">
			<div class="section-heading service-heading">
				<div>
					<p class="eyebrow">Bring your people. I’ll bring the party.</p>
					<h2>What are we<br /><em>celebrating?</em></h2>
				</div>
				<p class="service-intro">One great night can sound a hundred different ways. Let's make it yours.</p>
			</div>
			<div class="service-grid">
				{serviceCards.map((service) => (
					<a class="service-card" href={service.href}>
						<span class={`service-card__image service-card__image--${service.tone}`}>
							{service.image ? (
								<Image src={service.image} alt={service.imageAlt} widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" width={900} format="webp" loading="lazy" />
							) : <span>{service.imageLabel}</span>}
						</span>
						<span class="service-card__content">
							<span class="service-card__eyebrow">{service.eyebrow}</span>
							<h3>{service.title}</h3>
							<span class="service-card__copy">{service.copy}</span>
							<span class="service-card__link">Explore {service.shortTitle} <span aria-hidden="true">→</span></span>
						</span>
					</a>
				))}
			</div>
		</section>

		<ReviewHighlights />

		<section class="about-band">
			<div class="page-width about-band__inner">
				<div class="about-band__portrait">
					<Image src={rachelPortrait} alt="DJ Rachel smiling in a silver jacket." widths={[400, 640, 960]} sizes="(max-width: 740px) calc(100vw - 36px), 45vw" width={960} format="webp" loading="lazy" />
				</div>
				<div class="about-band__copy">
					<p class="eyebrow">A little about me</p>
					<h2>Let's get acquainted.<br /><em>I'll go first.</em></h2>
					<p>
						Pull up a chair and grab a snack, because I'd like to tell you a story. You should love your DJ, and part of that is knowing how this whole thing began. It starts with a wedding that needed a DJ and a yes I never planned on saying.
					</p>
					<a class="button" href="/about/">Meet DJ Rachel</a>
				</div>
			</div>
		</section>

		<section class="section page-width reach-out" aria-labelledby="reach-out-heading">
			<h2 id="reach-out-heading">What happens when <em>you reach out?</em></h2>
			<p class="reach-out__intro">You don’t need a finished timeline or a single song picked out. Start with what you know, and we’ll take it from there.</p>
			<div class="reach-out__grid">
				<article><h3>01 · Tell me what you’re dreaming up.</h3><p>Fill out my contact form with your date and a little about what you’re planning. A few details are plenty. If you already have a vision for the dance floor, I want to hear it.</p></article>
				<article><h3>02 · I’ll check my calendar.</h3><p>I’ll get back to you to let you know if I’m available for your date. If I am, we’ll find a time to chat.</p></article>
				<article><h3>03 · Let’s chat.</h3><p>We’ll talk through what you’re planning, what matters most to you, and how you want the room to feel. Bring your questions, your must-haves, and your strong opinions about line dances too.</p></article>
				<article><h3>04 · I’ll send a proposal. You take it from there.</h3><p>I’ll put together a straightforward, personalized proposal based on everything we discussed. Take a look, ask me anything, and decide if it feels like the right fit.</p><p class="reach-out__reassurance"><strong>No pressure, <em>ever</em>. You should absolutely love your DJ!</strong></p></article>
			</div>
			<a class="button" href="https://www.honeybook.com/widget/dj_rachel_entertainment_272653/cf_id/65dfb2edcac387001f35d407">Tell me about your event</a>
		</section>

		<section class="mix-sample" aria-labelledby="mix-heading">
			<div class="page-width mix-sample__inner">
				<div>
					<h2 id="mix-heading">Press play.<br /><em>Feel the vibe.</em></h2>
					<p>Check me out. Listen to a live set on Mixcloud.</p>
				</div>
				<a class="mix-sample__play" href="https://www.mixcloud.com/djrachellynch/dj-rachel-fp-movement-grand-opening-set-part-1/" target="_blank" rel="noopener noreferrer" aria-label="Listen to DJ Rachel’s FP Movement live mix on Mixcloud (opens in a new tab)">
					<span class="mix-sample__record" aria-hidden="true"><span><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 4v16l13-8z" /></svg></span></span>
					<span><strong>Listen to the mix →</strong><small>DJ Rachel · Live at FP Movement · Part 1</small></span>
				</a>
			</div>
		</section>

		<ContactCta />
	</main>
</SiteLayout>

<script>
	const reel = document.querySelector<HTMLVideoElement>(".hero-reel");
	const sound = document.querySelector<HTMLButtonElement>("[data-hero-sound]");
	const label = sound?.querySelector("span");
	if (reel && sound && label) {
		const updateSound = () => {
			const audible = !reel.muted && reel.volume > 0;
			label.textContent = audible ? "Sound off" : "Sound on";
			sound.setAttribute("aria-label", audible ? "Turn video sound off" : "Turn video sound on");
		};
		sound.addEventListener("click", () => {
			if (reel.muted || reel.volume === 0) {
				reel.muted = false;
				if (reel.volume === 0) reel.volume = 1;
				void reel.play().catch(() => {});
			} else {
				reel.muted = true;
			}
			updateSound();
		});
		reel.addEventListener("volumechange", updateSound);
		updateSound();
		sound.hidden = false;
	}
</script>

<style>
	.hero-media { display: grid; gap: 12px; }
	.hero-sound-toggle { justify-self: end; gap: 8px; cursor: pointer; }
	.hero-sound-toggle[hidden] { display: none; }
	.hero-title { text-transform: none; }
	.hero-copy .hero-lead { margin-bottom: 20px; font-family: var(--body); font-size: 1.1rem; font-weight: 700; }
	.hero-copy .hero-lead strong { font: inherit; }
	.reach-out h2 { overflow-wrap: anywhere; }
	.reach-out__intro { margin-block: 28px 36px; font-size: 1.1rem; line-height: 1.8; text-wrap: pretty; }
	.reach-out__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-bottom: 32px; }
	.reach-out h3 { font-family: var(--display); font-size: 1.4rem; font-weight: 900; line-height: 1.3; }
	.reach-out__grid p { line-height: 1.8; }
	.reach-out__reassurance em { font-style: italic; font-synthesis: style; }
	@media (max-width: 700px) { .reach-out__grid { grid-template-columns: minmax(0, 1fr); gap: 20px; } }

	.service-heading { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
	.service-intro { margin: 0; color: #000; font-size: clamp(1.125rem, 2vw, 1.5rem); font-weight: 800; line-height: 1.55; }
	.about-band__portrait {
		width: 100%;
		aspect-ratio: 1;
		overflow: hidden;
	}
	.about-band__portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
</style>
