---
import { weddingPhotos } from "../data/weddingPhotos";
---

<wedding-carousel class="page-hero__art wedding-carousel" role="region" aria-label="Wedding photos" aria-roledescription="carousel">
	{weddingPhotos.length ? weddingPhotos.map((photo, index) => (
		<img src={photo.src} alt={photo.alt} hidden={index !== 0} width="800" height="800" loading={index === 0 ? "eager" : "lazy"} />
	)) : <p class="wedding-carousel__placeholder">Wedding photos coming soon</p>}
	{weddingPhotos.length > 1 && <div class="wedding-carousel__controls">
		<button type="button" data-previous aria-label="Previous wedding photo">←</button>
		<button type="button" data-pause>Pause slideshow</button>
		<button type="button" data-next aria-label="Next wedding photo">→</button>
	</div>}
</wedding-carousel>

<script>
	class WeddingCarousel extends HTMLElement {
		connectedCallback() {
			const photos = [...this.querySelectorAll("img")];
			if (photos.length < 2) return;
			let index = 0;
			let paused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const pause = this.querySelector<HTMLButtonElement>("[data-pause]")!;
			const updatePause = () => { pause.textContent = paused ? "Play slideshow" : "Pause slideshow"; };
			const show = (offset: number) => {
				photos[index].hidden = true;
				index = (index + offset + photos.length) % photos.length;
				photos[index].hidden = false;
			};
			this.querySelector("[data-previous]")?.addEventListener("click", () => show(-1));
			this.querySelector("[data-next]")?.addEventListener("click", () => show(1));
			pause.addEventListener("click", () => { paused = !paused; updatePause(); });
			updatePause();
			const timer = window.setInterval(() => {
				if (!paused && !document.hidden && !this.matches(":hover, :focus-within")) show(1);
			}, 5000);
			this.cleanup = () => window.clearInterval(timer);
		}
		cleanup?: () => void;
		disconnectedCallback() { this.cleanup?.(); }
	}
	if (!customElements.get("wedding-carousel")) customElements.define("wedding-carousel", WeddingCarousel);
</script>

<style>
	.wedding-carousel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.wedding-carousel img[hidden] { display: none; }
	.wedding-carousel__placeholder { padding: 24px; text-align: center; font-weight: 700; }
	.wedding-carousel__controls { position: absolute; inset: auto 12px 12px; display: flex; justify-content: center; gap: 8px; }
	.wedding-carousel__controls button { padding: 10px 14px; border: 2px solid white; background: #191216; color: white; cursor: pointer; font: inherit; }
</style>
