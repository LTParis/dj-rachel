---
import WeddingCarousel from "./WeddingCarousel.astro";
interface Offer {
	title: string;
	copy: string;
}

interface Step {
	title: string;
	copy: string;
}

interface Props {
	eyebrow: string;
	title: string;
	lead: string;
	offersHeading: string;
	offers: Offer[];
	highlightOffers?: boolean;
	weddingHero?: boolean;
	steps: Step[];
}

const { eyebrow, title, lead, offersHeading, offers, steps, highlightOffers = false, weddingHero = false } = Astro.props;
---

<main id="main">
	<section class="page-hero page-width">
		<div class="page-hero__copy">
			<p class="eyebrow">{eyebrow}</p>
			<h1 set:html={title} />
			<p class="hero-lead">{lead}</p>
			<a class="button" href="/#contact">Let's plan your event</a>
		</div>
		{weddingHero ? <WeddingCarousel /> : <div class="page-hero__art" aria-hidden="true">
			<span class="page-hero__art-disc"></span>
			<span class="page-hero__art-label">MAKE<br />IT A<br /><em>NIGHT.</em></span>
		</div>}
	</section>

	<section class="section page-width">
		<div class="section-heading">
			<div>
				<p class="eyebrow">The good stuff</p>
				<h2>{weddingHero ? <>everything your <em>celebration</em> needs</> : offersHeading}</h2>
			</div>
			<p class="section-aside">Tell me what matters most. No packages to decode. No equipment to worry about. Just my very best, built around your event, from start to finish.</p>
		</div>
		<div class:list={["offer-grid", { "offer-grid--highlighted": highlightOffers }]}>
			{offers.map((offer, index) => (
				<article class="offer-card">
					<span class="offer-card__number">0{index + 1}</span>
					<h3>{offer.title}</h3>
					<p>{offer.copy}</p>
				</article>
			))}
		</div>
	</section>

	<section class="steps-band">
		<div class="page-width">
			<p class="eyebrow">Easy does it</p>
			<h2>how we make it <em>happen.</em></h2>
			<div class="steps-grid">
				{steps.map((step, index) => (
					<article class="step-card">
						<span class="step-card__number">0{index + 1}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<slot />
</main>
