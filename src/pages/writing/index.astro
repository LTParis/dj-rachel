---
import SiteLayout from "../../layouts/SiteLayout.astro";
import type { MarkdownInstance } from "astro";
import { publishedArticles } from "../../data/publishedArticles";
interface Article { title: string; description: string; date: string; topic: string; draft?: boolean; }
const articles = Object.values(import.meta.glob<MarkdownInstance<Article>>("./posts/*.md", { eager: true }))
	.filter(article => !article.frontmatter.draft)
	.sort((a, b) => String(b.frontmatter.date).localeCompare(String(a.frontmatter.date)));
---
<SiteLayout title="Blogs | DJ Rachel Lynch" description="Advice, thoughts, and articles from DJ Rachel about weddings, DJing, the industry, and more.">
	<main id="main">
		<section class="page-width writing-intro">
			<p class="eyebrow">Advice · Thoughts · Articles</p>
			<h1>Beyond <em>the booth.</em></h1>
			<p class="hero-lead">Nearly 20 years in, I've learned a lot, and I'm not shy about sharing it. Take a look at what I've written for the industry, on my blog and in other publications, and click any article to read it in full.</p>
		</section>
		<section class="page-width writing-list" aria-label="Articles">
			{articles.length ? <div class="writing-grid">{articles.map(article => <a class="writing-card" href={article.url}>
				<p class="eyebrow">{article.frontmatter.topic}</p>
				<h3>{article.frontmatter.title}</h3>
				<p>{article.frontmatter.description}</p>
				<span class="button button--small">Read article →</span>
			</a>)}</div> : null}
			<div class="writing-grid">
				{publishedArticles.map(article => <a class="writing-card published-article" href={article.href} target="_blank" rel="noopener noreferrer">
					<p class="eyebrow">{article.publication} · {article.topic}</p>
					<h3>{article.title}</h3>
					<p>{article.description}</p>
					<span class="button button--small">{article.archive ? "Read in the publication archive" : "Read the original article"} →</span>
				</a>)}
			</div>
		</section>
	</main>
</SiteLayout>
<style>
	.writing-intro { padding-block: 70px 35px; }
	h1 { font-size: clamp(3rem, 8vw, 7rem); }
	.writing-list { padding-block: 35px 90px; }
	.writing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; }
	.writing-grid + .writing-grid { margin-top: 24px; }
	.writing-card { padding: 28px; border: 4px solid var(--pink); background: #000; color: #fff; text-decoration: none; }
	.writing-card:hover, .writing-card:focus-visible { background: #000; outline: 3px solid var(--pink); outline-offset: 4px; }
	.writing-card .eyebrow { color: #fff; }
	.writing-card h3 { color: #fff; font-weight: 900; font-family: var(--display); font-size: 1.6rem; }
</style>
