---
import { brandClients } from "../data/brandClients";
---

<section class="brand-clients" aria-labelledby="brand-clients-heading">
	<div class="page-width">
		<p class="eyebrow">Retail + corporate clients</p>
		<h2 id="brand-clients-heading">their brand.<br /><em>my kind of energy.</em></h2>
		<p class="brand-clients__intro">Grand openings. Brand events. Galas. Holiday parties. A few of the names that trusted me to make their special occasions unmistakably theirs.</p>
		<ul class="brand-clients__grid">
			{brandClients.filter((brand) => brand.logo).map((brand) => (
				<li class="brand-clients__card">
					<div class:list={["brand-clients__logo", { "brand-clients__logo--dark": brand.logoBackground === "dark" }]}>
						<img src={brand.logo} alt={brand.name} width="240" height="110" loading="lazy" />
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.brand-clients { padding-block: clamp(56px, 7vw, 88px); background: #000; color: #fff; }
	.brand-clients .eyebrow { color: #f17eb2; }
	.brand-clients h2 { color: #fff; font-size: clamp(2.7rem, 5vw, 4.5rem); }
	.brand-clients h2 em { color: #f17eb2; }
	.brand-clients__intro { max-width: 620px; margin: 24px 0 36px; line-height: 1.7; }
	.brand-clients__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; padding: 0; margin: 0; list-style: none; }
	.brand-clients__card { display: flex; flex-direction: column; background: #fff; color: #191216; border: 3px solid var(--pink); padding: 24px; text-align: center; }
	.brand-clients__logo { display: grid; place-items: center; min-height: 120px; }
	.brand-clients__logo--dark { background: #191216; padding: 12px; }
	.brand-clients__logo img { width: 100%; max-width: 240px; height: 110px; object-fit: contain; }
	@media (max-width: 700px) { .brand-clients__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .brand-clients__card { padding: 16px; } }
	@media (max-width: 380px) { .brand-clients__grid { grid-template-columns: 1fr; } }
</style>
