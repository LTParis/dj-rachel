---
import { formatReviewDate, heroReviewQuotes, reviewData } from "../data/reviews";

// Each pull quote must be an exact excerpt of the imported review text, so a
// re-import that changes or renumbers reviews fails the build instead of
// showing words a reviewer never wrote.
const slides = heroReviewQuotes.map(({ id, quote }) => {
	const review = reviewData.reviews.find((item) => item.id === id);
	if (!review) throw new Error(`Hero review "${id}" is missing from reviews.json`);
	if (!review.text.includes(quote)) {
		throw new Error(`Hero quote for "${id}" is not an exact excerpt of the review text`);
	}
	return { id, quote, sources: review.sources };
});
---

<section
	class="hero-reviews"
	aria-roledescription="carousel"
	aria-label="Client reviews"
	data-hero-reviews
>
	<div class="hero-reviews__slides" aria-live="off" data-slides>
		{slides.map((slide, index) => (
			<figure
				class:list={["hero-review", { "is-active": index === 0 }]}
				role="group"
				aria-roledescription="slide"
				aria-label={`${index + 1} of ${slides.length}`}
				data-slide
			>
				<blockquote>“{slide.quote}”</blockquote>
				<figcaption>
					{slide.sources.map((source) => {
						const date = formatReviewDate(source.date, source.dateIsExact);
						return (
							<p class="hero-review__source">
								<strong>{source.reviewer ?? "Reviewer"}</strong>
								<span>
									{source.rating !== null ? (
										<>
											<span class="hero-review__stars" aria-hidden="true">{"★".repeat(source.rating)}</span>
											<span class="visually-hidden">{source.rating} out of 5 stars, </span>
											{source.platform} review
										</>
									) : (
										<>{source.platform} {source.recommendation ? "recommendation" : "review"}</>
									)}
									{date && <> · {date}</>}
								</span>
							</p>
						);
					})}
				</figcaption>
			</figure>
		))}
	</div>
	<div class="hero-reviews__controls" data-controls hidden>
		<button type="button" class="hero-reviews__button" aria-label="Pause rotating reviews" data-toggle>
			<svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
			<svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
		</button>
		<button type="button" class="hero-reviews__button" aria-label="Previous review" data-prev>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
		</button>
		<button type="button" class="hero-reviews__button" aria-label="Next review" data-next>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
		</button>
	</div>
</section>

<script>
	const ROTATE_MS = 7000;

	for (const root of document.querySelectorAll<HTMLElement>("[data-hero-reviews]")) {
		const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
		const live = root.querySelector<HTMLElement>("[data-slides]")!;
		const controls = root.querySelector<HTMLElement>("[data-controls]")!;
		const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
		if (slides.length < 2) continue;

		let index = 0;
		let timer: number | undefined;
		// Visitors who prefer reduced motion start paused; arrows still work.
		let userPaused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let hovering = false;
		let focused = false;

		const show = (next: number) => {
			slides[index].classList.remove("is-active");
			index = (next + slides.length) % slides.length;
			slides[index].classList.add("is-active");
		};

		const sync = () => {
			window.clearInterval(timer);
			timer = undefined;
			const running = !userPaused && !hovering && !focused;
			if (running) timer = window.setInterval(() => show(index + 1), ROTATE_MS);
			// Announce changes only when the visitor is driving the carousel.
			live.setAttribute("aria-live", running ? "off" : "polite");
			toggle.classList.toggle("is-paused", userPaused);
			toggle.setAttribute("aria-label", userPaused ? "Play rotating reviews" : "Pause rotating reviews");
		};

		root.querySelector("[data-prev]")!.addEventListener("click", () => show(index - 1));
		root.querySelector("[data-next]")!.addEventListener("click", () => show(index + 1));
		toggle.addEventListener("click", () => {
			userPaused = !userPaused;
			sync();
		});
		root.addEventListener("pointerenter", () => { hovering = true; sync(); });
		root.addEventListener("pointerleave", () => { hovering = false; sync(); });
		root.addEventListener("focusin", () => { focused = true; sync(); });
		root.addEventListener("focusout", (event) => {
			if (!root.contains(event.relatedTarget as Node | null)) {
				focused = false;
				sync();
			}
		});

		controls.hidden = false;
		sync();
	}
</script>
